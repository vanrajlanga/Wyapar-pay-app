{
  "name": "wyaparpayexpo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "lint": "echo 'No linter configured yet'",
    "validate": "npm run type-check && npm run lint",
    "build-check": "npm run validate && echo '✅ Build validation passed!'",
    "build:android:apk": "eas build --profile production-apk --platform android",
    "build:android:aab": "eas build --profile production --platform android",
    "build:ios": "eas build --profile production --platform ios",
    "build:all": "./build-production.sh all"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.907.0",
    "@aws-sdk/s3-request-presigner": "^3.907.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "expo": "54.0.12",
    "expo-constants": "~17.0.5",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.17",
    "expo-device": "^8.0.9",
    "expo-file-system": "^19.0.17",
    "expo-font": "^14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-local-authentication": "^17.0.7",
    "expo-localization": "^17.0.7",
    "expo-media-library": "^18.2.0",
    "expo-notifications": "*",
    "expo-secure-store": "^15.0.7",
    "expo-status-bar": "~3.0.8",
    "i18next": "^25.5.3",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.0.0",
    "react-native": "0.81.4",
    "react-native-get-random-values": "^2.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-paper": "^5.14.5",
    "react-native-phosphor": "^2.1.1",
    "react-native-razorpay": "^2.3.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vector-icons": "^10.3.0",
