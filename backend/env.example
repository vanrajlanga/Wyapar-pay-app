# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=wyapar_pay
# Note: DB_SYNCHRONIZE is intentionally removed - we use manual schema creation

# Redis Configuration (Optional - Disabled by default for cost savings)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
# IMPORTANT: Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The app will NOT start in production with weak/default secrets
JWT_SECRET=GENERATE_STRONG_SECRET_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=GENERATE_STRONG_SECRET_MINIMUM_32_CHARACTERS
JWT_REFRESH_EXPIRES_IN=7d
# Optional: Separate encryption key for sensitive data (recommended for production)
ENCRYPTION_KEY=

# Server Configuration
PORT=3000
NODE_ENV=development

# CORS Configuration
# In production, MUST specify allowed origins (comma-separated list)
# Example: ALLOWED_ORIGINS=https://app.wyaparpay.com,https://www.wyaparpay.com
ALLOWED_ORIGINS=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Payment Gateway Configuration (Razorpay)
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# SMS Configuration (Digimiles AOC Portal)
# Enable/disable SMS sending (default: true)
SMS_ENABLED=true
# SMS Provider: generic (Digimiles), twilio, msg91, textlocal, mock
SMS_PROVIDER=generic
# Enable fallback to other providers if primary fails (default: false)
SMS_USE_FALLBACK=false
# Digimiles AOC Portal API Configuration
SMS_API_URL=https://api.aoc-portal.com/v1/sms
SMS_API_KEY=c95DfaxI9CjuRuvb7wvIeR2YRg3jE2
SMS_SENDER_ID=WYAPAY

# Twilio Configuration (if using Twilio provider)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# MSG91 Configuration (if using MSG91 provider)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_ROUTE=4

# Email Configuration (Zoho ZeptoMail)
# Get your token from: https://console.zeptomail.com/
# Documentation: https://www.zoho.com/zeptomail/help/smtp-home.html
# API URL format: https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_TOKEN=your-zeptomail-send-token
ZEPTOMAIL_FROM_EMAIL=noreply@wyaparpay.com
ZEPTOMAIL_FROM_NAME=WyaparPay

# AWS Configuration (for S3 profile images and documents)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=wyaparpay-assets
S3_PROFILE_FOLDER=profile-images
S3_DOCUMENTS_BUCKET=txn-documents
S3_DOCUMENTS_FOLDER=test-documents

# BBPS Configuration
BBPS_API_URL=https://api.bbps.com
BBPS_API_KEY=your-bbps-api-key
BBPS_MERCHANT_ID=your-bbps-merchant-id

# Push Notification Configuration (Expo)
# Optional: Expo access token for production (get from https://expo.dev/accounts/[account]/settings/access-tokens)
# If not provided, Expo SDK will work but with rate limits
EXPO_ACCESS_TOKEN=
# Enable/disable push notifications (default: true)
PUSH_NOTIFICATIONS_ENABLED=true
# Push notification provider (default: expo)
PUSH_PROVIDER=expo
# Retry configuration
PUSH_MAX_RETRIES=3
PUSH_RETRY_DELAY=1000
# Batch size for bulk notifications
PUSH_BATCH_SIZE=100

# KWIKAPI Configuration (Recharge & Bill Payment Gateway)
# Enable/disable KWIKAPI integration (default: true)
KWIKAPI_ENABLED=true
# Environment: uat (for development/testing) or production
KWIKAPI_ENVIRONMENT=uat
# UAT/Mock API Base URL
KWIKAPI_UAT_URL=https://uat.kwikapi.com
# Production API Base URL
KWIKAPI_PRODUCTION_URL=https://www.kwikapi.com
# Your KWIKAPI API Key (get from KWIKAPI dashboard)
KWIKAPI_API_KEY=your_kwikapi_key_here
# Request timeout in milliseconds (default: 30000 = 30 seconds)
KWIKAPI_TIMEOUT=30000
# Number of retry attempts on failure (default: 3)
KWIKAPI_RETRY_ATTEMPTS=3
# Delay between retries in milliseconds (default: 1000 = 1 second)
KWIKAPI_RETRY_DELAY=1000

# Security
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
